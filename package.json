    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "~19.1.0",
    "dotenv": "~16.4.5",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "3.9.10",
