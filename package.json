{
  "name": "app-migraine",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts && prettier --write --log-level warn types/database.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "^2.93.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-auth-session": "~57.0.14",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "~57.1.1",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1313.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "~19.1.0",
    "dotenv": "~16.4.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.0",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/functions/"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native-calendars": {
      "react-native-safe-area-context": "$react-native-safe-area-context"
    }
  }
}
