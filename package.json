{
  "name": "app-migraine",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts && prettier --write --log-level warn types/database.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.93.1",
    "babel-preset-expo": "~55.0.8",
    "expo": "~55.0.31",
    "expo-asset": "~55.0.20",
    "expo-auth-session": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-print": "~55.0.19",
    "expo-router": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-speech": "~55.0.18",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.22",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-calendars": "^1.1313.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "~19.1.0",
    "dotenv": "~16.4.5",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "prettier": "3.9.10",
    "react-test-renderer": "19.2.0",
    "supabase": "^2.120.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/functions/"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native-calendars": {
      "react-native-safe-area-context": "$react-native-safe-area-context"
    }
  }
}
